# --- Required in all environments ---
# Pooled Supabase connection string (runtime queries).
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct Supabase connection string (Prisma migrations only).
DIRECT_URL="postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres"
# Auth.js session signing secret. Generate with: npx auth secret
AUTH_SECRET="replace-me-with-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- "Continue with Microsoft" sign-in ---
# From an Azure App Registration (see README.md for the walkthrough). Login
# still works via email/password without these; only the Microsoft button
# needs them.
# AUTH_MICROSOFT_ENTRA_ID_ID="<Application (client) ID>"
# AUTH_MICROSOFT_ENTRA_ID_SECRET="<Client secret value>"

# --- Required to send the one-time registration verification email ---
# API key from resend.com. Without this, accounts are created but never
# receive a verification email, so credentials sign-in stays blocked.
RESEND_API_KEY="re_your_api_key"
# "From" address. Resend's shared onboarding@resend.dev works without owning
# a domain, but has recipient restrictions until you verify one.
EMAIL_FROM="PartnerUp <onboarding@resend.dev>"

# --- Required to run Mosaic imports ---
# URL of the scraper worker service.
SCRAPER_URL="http://localhost:4000"
# Shared secret; must match WORKER_SECRET in scraper-worker/.env.
WORKER_SECRET="replace-me-with-a-shared-secret"

# --- Local development only ---
# The scraper runs headless by default. Set false to watch the browser while
# debugging (slower). SCRAPER_FULL_TERM=true disables the early-exit optimization
# and scans every week of the term.
# SCRAPER_HEADLESS="false"
# SCRAPER_FULL_TERM="true"
# Seed users for `npm run seed` (local test accounts; the seed script refuses
# to run in production and has no default credentials).
SEED_USER_EMAIL="your-test-user@mcmaster.ca"
SEED_USER_PASSWORD="choose-a-local-only-password"
SEED_USER_NAME="Test User"
# Optional second local account:
# SEED_USER_2_EMAIL=""
# SEED_USER_2_PASSWORD=""
# SEED_USER_2_NAME=""
