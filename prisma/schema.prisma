generator client {
  provider = "prisma-client"
  output   = "../apps/web/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ImportJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ComponentType {
  LAB
  TUTORIAL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum DiscoverableSectionStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PartnerRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

model User {
  id                      String                @id @default(cuid())
  email                   String                @unique
  displayName             String?
  importJobs              ImportJob[]
  sections                Section[]
  discoverableSections    DiscoverableSection[]
  sentPartnerRequests     PartnerRequest[]      @relation("PartnerRequestSender")
  receivedPartnerRequests PartnerRequest[]      @relation("PartnerRequestReceiver")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model ImportJob {
  id           String          @id @default(cuid())
  userId       String
  status       ImportJobStatus @default(QUEUED)
  errorMessage String?
  startedAt    DateTime?
  finishedAt   DateTime?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections     Section[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, status])
  @@index([createdAt])
}

model Section {
  id                   String                @id @default(cuid())
  userId               String
  importJobId          String?
  term                 String
  courseCode           String
  componentType        ComponentType
  sectionCode          String
  dayOfWeek            DayOfWeek
  startTime            DateTime              @db.Time(0)
  endTime              DateTime              @db.Time(0)
  location             String
  rawTitle             String?
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  importJob            ImportJob?            @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  discoverableSections DiscoverableSection[]
  partnerRequests      PartnerRequest[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([userId, term, courseCode, componentType, sectionCode, dayOfWeek, startTime, endTime])
  @@index([userId, term])
  @@index([courseCode, term])
  @@index([componentType])
}

model DiscoverableSection {
  id        String                    @id @default(cuid())
  userId    String
  sectionId String
  status    DiscoverableSectionStatus @default(ACTIVE)
  note      String?
  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  section   Section                   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt DateTime                  @default(now())
  updatedAt DateTime                  @updatedAt

  @@unique([userId, sectionId])
  @@index([sectionId, status])
  @@index([userId, status])
}

model PartnerRequest {
  id         String               @id @default(cuid())
  senderId   String
  receiverId String
  sectionId  String
  note       String?
  status     PartnerRequestStatus @default(PENDING)
  sender     User                 @relation("PartnerRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User                 @relation("PartnerRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  section    Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([senderId, receiverId, sectionId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([sectionId, status])
}
