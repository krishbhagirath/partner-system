generator client {
  provider   = "prisma-client"
  output     = "../apps/web/src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ImportJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ComponentType {
  LAB
  TUTORIAL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PartnerRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

enum PartnerNeedResponse {
  YES
  NO
  UNSURE
}

model User {
  id                      String                @id @default(cuid())
  email                   String                @unique
  emailVerified           DateTime?
  image                   String?
  name                    String?
  displayName             String?
  passwordHash            String?
  program                 String?
  year                    String?
  bio                     String?
  notifyOnRequest         Boolean               @default(true)
  notifyOnMatch           Boolean               @default(true)
  contactPhone            String?
  contactInstagram        String?
  contactOther            String?
  accounts                Account[]
  sessions                Session[]
  importJobs              ImportJob[]
  sections                Section[]
  discoverableSections    DiscoverableSection[]
  sentPartnerRequests     PartnerRequest[]      @relation("PartnerRequestSender")
  receivedPartnerRequests PartnerRequest[]      @relation("PartnerRequestReceiver")
  partnerNeedVotes        PartnerNeedVote[]
  teamMemberships         TeamMember[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model ImportJob {
  id              String          @id @default(cuid())
  userId          String
  status          ImportJobStatus @default(QUEUED)
  errorMessage    String?
  progressStage   String?
  progressCurrent Int?
  progressTotal   Int?
  startedAt       DateTime?
  finishedAt      DateTime?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections     Section[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, status])
  @@index([createdAt])
}

model Section {
  id                   String                @id @default(cuid())
  userId               String
  importJobId          String?
  term                 String
  courseCode           String
  componentType        ComponentType
  sectionCode          String
  dayOfWeek            DayOfWeek
  startTime            DateTime              @db.Time(0)
  endTime              DateTime              @db.Time(0)
  location             String
  rawTitle             String?
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  importJob            ImportJob?            @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  discoverableSections DiscoverableSection[]
  partnerRequests      PartnerRequest[]
  teamMemberships      TeamMember[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([userId, term, courseCode, componentType, sectionCode, dayOfWeek, startTime, endTime])
  @@index([userId, term])
  @@index([courseCode, term, componentType])
}

model DiscoverableSection {
  id        String   @id @default(cuid())
  userId    String
  sectionId String
  note      String?
  isActive  Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sectionId])
  @@index([sectionId, isActive])
  @@index([userId, isActive])
}

model PartnerRequest {
  id         String               @id @default(cuid())
  senderId   String
  receiverId String
  sectionId  String
  // Context only, never authoritative: the open team the sender meant to join
  // when they sent this. Accepting recomputes the target from the responder's
  // current team (they may have left since), then overwrites this with the team
  // the request actually produced — including the new-pair case — so it ends up
  // meaning "the team this request is about", which is what the notification
  // feed and post-accept deep links need.
  //
  // Teams are created lazily on the first accept; solo students deliberately do
  // not get a team of one.
  targetTeamId String?
  note       String?
  status     PartnerRequestStatus @default(PENDING)
  sender     User                 @relation("PartnerRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User                 @relation("PartnerRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  section    Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  targetTeam Team?                @relation(fields: [targetTeamId], references: [id], onDelete: SetNull)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([senderId, receiverId, sectionId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([sectionId, status])
  @@index([targetTeamId, status])
}

// A team is a set of students working together in one section. A partnership is
// simply a team of two — there is no separate "match" concept and no declared or
// maximum team size, because nothing in the imported schedule data says how big a
// course's groups should be.
//
// `isComplete` defaults to true so a newly formed pair behaves exactly like a
// confirmed match does today: hidden from discovery, no further join requests.
// Most McMaster labs are pairs, and a finished pair never returns to the app to
// close their team, so the default has to be correct for the user who does
// nothing. Teams that need more people flip it off explicitly.
model Team {
  id            String           @id @default(cuid())
  // Section identity is denormalized onto the team because Section rows are
  // per-user — every student in the same lab owns a separate row, so there is no
  // canonical section to point at. These are the same seven fields that
  // buildSectionDiscoveryKey() joins (server/lab-partner.ts).
  //
  // Longer term this wants a canonical SectionIdentity table that Section,
  // DiscoverableSection, PartnerRequest and Team all reference; sectionKey buys
  // most of that benefit without backfilling an id onto four existing tables.
  term          String
  courseCode    String
  componentType ComponentType
  sectionCode   String
  dayOfWeek     DayOfWeek
  startTime     DateTime         @db.Time(0)
  endTime       DateTime         @db.Time(0)
  // buildSectionDiscoveryKey() output for the fields above, stored so it can be
  // indexed and referenced by TeamMember's composite foreign key.
  sectionKey    String
  isComplete    Boolean          @default(true)
  members       TeamMember[]
  joinRequests  PartnerRequest[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Exists only to give TeamMember's composite foreign key a unique target.
  // Trivially satisfied, since `id` is already the primary key.
  @@unique([id, sectionKey])
  @@index([sectionKey, isComplete])
}

model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  // Write-once copy of Team.sectionKey. A unique constraint cannot span a
  // relation, so the constraint that matters has to live on the row carrying
  // userId. The composite foreign key below is what stops this copy from ever
  // disagreeing with the team's own key — without it the denormalized value
  // could drift and silently defeat the uniqueness guarantee.
  sectionKey String
  userId     String
  // The member's own Section row. Required and cascading so that dropping or
  // re-importing a section clears team membership through exactly the same
  // mechanism that already clears PartnerRequests, rather than leaving students
  // on teams for courses they are no longer in.
  sectionId  String
  team       Team     @relation(fields: [teamId, sectionKey], references: [id, sectionKey], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  section    Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  joinedAt   DateTime @default(now())

  // The core invariant: one team per student per section identity, enforced by
  // Postgres instead of by the application-level check it replaces. Note that
  // [teamId, userId] would be redundant — same team implies same sectionKey via
  // the composite FK, so it is already covered here.
  @@unique([userId, sectionKey])
  @@index([teamId])
  @@index([sectionId])
  @@index([userId])
}

// Crowd-sourced signal on whether a course's lab/tutorial actually involves
// partner work, scoped to course+component (not a specific section/term) so
// votes pool across every section and term of e.g. "COMPSCI 2C03 Lab".
model PartnerNeedVote {
  id            String              @id @default(cuid())
  userId        String
  courseCode    String
  componentType ComponentType
  response      PartnerNeedResponse
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([userId, courseCode, componentType])
  @@index([courseCode, componentType])
}
