// PARTIAL, READ-ONLY MIRROR of the canonical schema at ../../prisma/schema.prisma.
//
// It exists only so `prisma generate` can produce a client for the three models this
// worker touches (User, ImportJob, Section). It intentionally omits Account, Session,
// VerificationToken, PartnerNeedVote, Team and TeamMember.
//
// NEVER run `prisma migrate` from this directory: Prisma would read this file as the
// intended state of the database and offer to DROP every omitted table. All migrations
// live in the root workspace.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ImportJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum ComponentType {
  LAB
  TUTORIAL
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum PartnerRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELED
}

model User {
  id                      String                @id @default(cuid())
  email                   String                @unique
  displayName             String?
  importJobs              ImportJob[]
  sections                Section[]
  discoverableSections    DiscoverableSection[]
  sentPartnerRequests     PartnerRequest[]      @relation("PartnerRequestSender")
  receivedPartnerRequests PartnerRequest[]      @relation("PartnerRequestReceiver")
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
}

model ImportJob {
  id              String          @id @default(cuid())
  userId          String
  status          ImportJobStatus @default(QUEUED)
  errorMessage    String?
  progressStage   String?
  progressCurrent Int?
  progressTotal   Int?
  startedAt       DateTime?
  finishedAt      DateTime?
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sections     Section[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([userId, status])
  @@index([createdAt])
}

model Section {
  id                   String                @id @default(cuid())
  userId               String
  importJobId          String?
  term                 String
  courseCode           String
  componentType        ComponentType
  sectionCode          String
  dayOfWeek            DayOfWeek
  startTime            DateTime              @db.Time(0)
  endTime              DateTime              @db.Time(0)
  location             String
  rawTitle             String?
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  importJob            ImportJob?            @relation(fields: [importJobId], references: [id], onDelete: SetNull)
  discoverableSections DiscoverableSection[]
  partnerRequests      PartnerRequest[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@unique([userId, term, courseCode, componentType, sectionCode, dayOfWeek, startTime, endTime])
  @@index([userId, term])
  @@index([courseCode, term, componentType])
}

model DiscoverableSection {
  id        String   @id @default(cuid())
  userId    String
  sectionId String
  note      String?
  isActive  Boolean  @default(true)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  section   Section  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sectionId])
  @@index([sectionId, isActive])
  @@index([userId, isActive])
}

model PartnerRequest {
  id         String               @id @default(cuid())
  senderId   String
  receiverId String
  sectionId  String
  note       String?
  status     PartnerRequestStatus @default(PENDING)
  sender     User                 @relation("PartnerRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User                 @relation("PartnerRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  section    Section              @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@unique([senderId, receiverId, sectionId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@index([sectionId, status])
}
