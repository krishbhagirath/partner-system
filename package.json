{
  "name": "mcmaster-lab-partner-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/web"
  ],
  "overrides": {
    "@hono/node-server": "1.19.13"
  },
  "scripts": {
    "dev": "npm run dev --workspace @labpartner/web",
    "build": "npm run db:generate && npm run build --workspace @labpartner/web",
    "start": "npm run start --workspace @labpartner/web",
    "lint": "npm run lint --workspace @labpartner/web",
    "typecheck": "npm run db:generate && npm run typecheck --workspace @labpartner/web",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@types/pg": "latest",
    "dotenv": "latest",
    "prettier": "latest",
    "prisma": "^6.19.3",
    "tsx": "latest"
  }
}
